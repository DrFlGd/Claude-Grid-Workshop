  "computed_skipped": [
    {
      "name": "adjustedStackCount",
      "group": "Beta - Fill Space",
      "expression": "Add_Adhesive_Base ? 1 : Stack_Count"
    },
    {
      "name": "Stacking_Method",
      "group": "Beta - Fill Space",
      "expression": "= \"Interface Layer\" ? Interface_Thickness : 0"
    }
  ],
  "model": "opengrid/tile"
