{
  "source": "vendor/hsw/custom-honeycomb-wall-v2.scad",
  "groups": [
    "Hex unit size",
    "Grid size settings",
    "Grid shape",
    "Flat edges"
  ],
  "parameters": [
    {
      "name": "depth",
      "group": "Hex unit size",
      "type": "number",
      "default": 8,
      "description": "Depth of the grid",
      "widget": "number"
    },
    {
      "name": "hole_width",
      "group": "Hex unit size",
      "type": "number",
      "default": 20,
      "description": "Width of the hexagon's hole (flat side to flat side)",
      "widget": "number"
    },
    {
      "name": "wall_thickness",
      "group": "Hex unit size",
      "type": "number",
      "default": 1.8,
      "description": "Thickness of the wall forming each hexagon",
      "widget": "number"
    },
    {
      "name": "max_grid_width",
      "group": "Grid size settings",
      "type": "number",
      "default": 100,
      "description": null,
      "widget": "number"
    },
    {
      "name": "max_grid_height",
      "group": "Grid size settings",
      "type": "number",
      "default": 100,
      "description": null,
      "widget": "number"
    },
    {
      "name": "flip_staggering",
      "group": "Grid shape",
      "type": "boolean",
      "default": true,
      "description": null,
      "widget": "checkbox"
    },
    {
      "name": "columns",
      "group": "Grid shape",
      "type": "number[]",
      "default": [
        3,
        5,
        8,
        6,
        4,
        3,
        4,
        5,
        6
      ],
      "description": "Amount of hexagons per column. Each entry defines a one column, where the number specifies the amount of hex units that will be generated for the respective column. (Ignored if \"fill\" is checked)",
      "widget": "vector"
    },
    {
      "name": "column_offsets",
      "group": "Grid shape",
      "type": "number[]",
      "default": [
        0,
        -2,
        -3,
        -1,
        0,
        2,
        4
      ],
      "description": "Optional: Offset for each column. This will ignore grid size limits.",
      "widget": "vector"
    },
    {
      "name": "column_gaps",
      "group": "Grid shape",
      "type": "list",
      "default": [
        [],
        [
          3,
          4
        ],
        [
          4,
          5
        ],
        [
          2
        ]
      ],
      "description": "Optional: Gaps for each column. *NOTE: Change these values in the code. Seems like 2D vector parameters aren't supported by the parameter editor and are always overwritten by the defaults.",
      "widget": "vector"
    },
    {
      "name": "edge_left",
      "group": "Flat edges",
      "type": "boolean",
      "default": false,
      "description": null,
      "widget": "checkbox"
    },
    {
      "name": "edge_top",
      "group": "Flat edges",
      "type": "boolean",
      "default": false,
      "description": null,
      "widget": "checkbox"
    },
    {
      "name": "edge_right",
      "group": "Flat edges",
      "type": "boolean",
      "default": false,
      "description": null,
      "widget": "checkbox"
    },
    {
      "name": "edge_bottom",
      "group": "Flat edges",
      "type": "boolean",
      "default": false,
      "description": null,
      "widget": "checkbox"
    }
  ],
  "computed_skipped": [
    {
      "name": "fill",
      "group": "Grid shape",
      "expression": "true;"
    },
    {
      "name": "hex_inner_r",
      "group": "Flat edges",
      "expression": "hole_width/sqrt(3)"
    },
    {
      "name": "hex_h",
      "group": "Flat edges",
      "expression": "hole_width+wall_thickness*2"
    },
    {
      "name": "hex_s",
      "group": "Flat edges",
      "expression": "hex_h/sqrt(3)"
    },
    {
      "name": "hex_d",
      "group": "Flat edges",
      "expression": "2*hex_s"
    },
    {
      "name": "hex_t",
      "group": "Flat edges",
      "expression": "hex_s/2"
    },
    {
      "name": "max_grid_hexagons_x",
      "group": "Flat edges",
      "expression": "fill? floor(max_grid_width/(hex_d-hex_t) +(edge_left?0.5:0) +(edge_right?0.5:0)): len(columns)"
    },
    {
      "name": "max_grid_hexagons_y",
      "group": "Flat edges",
      "expression": "fill? floor(max_grid_height/hex_h +(edge_top?0.5:0) +(edge_bottom?0.5:0)): max(columns)"
    },
    {
      "name": "max_grid_hexagons_y_lo",
      "group": "Flat edges",
      "expression": "fill? floor(max_grid_height/hex_h - 0.5 +(edge_top?0.5:0) +(edge_bottom?0.5:0)): (max(columns) - 0.5)"
    },
    {
      "name": "total_width",
      "group": "Flat edges",
      "expression": "max_grid_hexagons_x * (hex_d-hex_t) + hex_t"
    },
    {
      "name": "total_height",
      "group": "Flat edges",
      "expression": "hex_h*max(max_grid_hexagons_y - 0.5, max_grid_hexagons_y_lo)"
    }
  ],
  "model": "hsw/grid"
}
