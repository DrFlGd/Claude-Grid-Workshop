    {
      "name": "Channel_Width_in_Units",
      "group": "Channel Size",
      "type": "number",
      "default": 1,
      "description": "Width (X axis) of channel in units. Default unit is 28mm",
      "widget": "number"
    },
    {
      "name": "Channel_Total_Height",
      "group": "Channel Size",
      "type": "number",
      "default": 22,
      "description": "Height (Z axis) including connector (in mm)",
      "min": 10,
      "step": 6,
      "max": 72,
      "widget": "slider"
    },
    {
      "name": "Bridge_Channel_Length_in_Units_Y_Axis_Bottom",
      "group": "Channel Size",
      "type": "number",
      "default": 1,
      "description": "Number of grids extending along the Y axis from the corner grid in units to the bottom (default unit is 28mm)",
      "widget": "number"
    },
    {
      "name": "Bridge_Channel_Length_in_Units_Y_Axis_Top",
      "group": "Channel Size",
      "type": "number",
      "default": 1,
      "description": "Number of grids extending along the Y axis from the corner grid in units to the top (default unit is 28mm)",
      "widget": "number"
    },
    {
      "name": "Units_Over",
      "group": "Channel Size",
      "type": "number",
      "default": 1,
      "description": "Grid units transition (Y axis, equal both sides)",
      "min": 0,
      "step": 0.5,
      "max": 10,
      "widget": "slider"
    },
    {
      "name": "Units_Up",
      "group": "Channel Size",
      "type": "number",
      "default": 1,
