      "widget": "dropdown",
      "options": [
        {
          "value": 0,
          "label": "continuous"
        },
        {
          "value": 1,
          "label": "broken"
        },
        {
          "value": 2,
          "label": "auto"
        },
        {
          "value": 3,
          "label": "right"
        },
        {
          "value": 4,
          "label": "center"
        },
        {
          "value": 5,
          "label": "left"
        },
        {
          "value": 6,
          "label": "none"
        }
      ]
    },
    {
      "name": "style_base",
      "group": "Styles",
      "type": "number",
      "default": 0,
