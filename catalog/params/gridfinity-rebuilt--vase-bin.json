      "widget": "dropdown",
      "options": [
        {
          "value": 0,
          "label": "all"
        },
        {
          "value": 1,
          "label": "corners"
        },
        {
          "value": 2,
          "label": "edges"
        },
        {
          "value": 3,
          "label": "auto"
        },
        {
          "value": 4,
          "label": "none"
        }
