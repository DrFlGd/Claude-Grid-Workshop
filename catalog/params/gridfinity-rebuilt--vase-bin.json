      "widget": "number"
    },
    {
      "name": "d_hole",
      "group": "Styles",
      "type": "number",
      "default": 26,
      "description": "Deprecated Variables",
      "widget": "number"
    },
    {
      "name": "r_c1",
      "group": "Styles",
      "type": "number",
      "default": 0.8,
      "description": null,
      "widget": "number"
