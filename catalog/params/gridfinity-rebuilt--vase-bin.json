{
  "source": "vendor/gridfinity-rebuilt/gridfinity-spiral-vase.scad",
  "groups": [
    "Bin or Base",
    "Printer Settings",
    "General Settings",
    "Toggles",
    "Styles"
  ],
  "parameters": [
    {
      "name": "type",
      "group": "Bin or Base",
      "type": "number",
      "default": 1,
      "description": null,
      "widget": "dropdown",
      "options": [
        {
          "value": 0,
          "label": "bin"
        },
        {
          "value": 1,
          "label": "base"
        }
      ]
    },
    {
      "name": "nozzle",
      "group": "Printer Settings",
      "type": "number",
      "default": 0.6,
      "description": "extrusion width (walls will be twice this size)",
      "widget": "number"
    },
    {
      "name": "layer",
      "group": "Printer Settings",
      "type": "number",
      "default": 0.35,
      "description": "slicer layer size",
      "widget": "number"
    },
    {
      "name": "bottom_layer",
      "group": "Printer Settings",
      "type": "number",
      "default": 3,
      "description": "number of base layers on build plate",
      "widget": "number"
    },
    {
      "name": "gridx",
      "group": "General Settings",
      "type": "number",
      "default": 1,
      "description": "number of bases along x-axis",
      "widget": "number"
    },
    {
      "name": "gridy",
      "group": "General Settings",
      "type": "number",
      "default": 1,
      "description": "number of bases along y-axis",
      "widget": "number"
    },
    {
      "name": "gridz",
      "group": "General Settings",
      "type": "number",
      "default": 6,
      "description": "bin height. See bin height information and \"gridz_define\" below.",
      "widget": "number"
    },
    {
      "name": "n_divx",
      "group": "General Settings",
      "type": "number",
      "default": 2,
      "description": "number of compartments along x-axis",
      "widget": "number"
    },
    {
      "name": "enable_holes",
      "group": "Toggles",
      "type": "boolean",
      "default": true,
      "description": "toggle holes on the base for magnet",
      "widget": "checkbox"
    },
    {
      "name": "enable_zsnap",
      "group": "Toggles",
      "type": "boolean",
      "default": false,
      "description": "round up the bin height to match the closest 7mm unit",
      "widget": "checkbox"
    },
    {
      "name": "enable_lip",
      "group": "Toggles",
      "type": "boolean",
      "default": true,
      "description": "toggle the lip on the top of the bin that allows stacking",
      "widget": "checkbox"
    },
    {
      "name": "enable_scoop_chamfer",
      "group": "Toggles",
      "type": "boolean",
      "default": true,
      "description": "chamfer inside bin for easy part removal",
      "widget": "checkbox"
    },
    {
      "name": "enable_funnel",
      "group": "Toggles",
      "type": "boolean",
      "default": true,
      "description": "funnel-like features on the back of tabs for fingers to grab",
      "widget": "checkbox"
    },
    {
      "name": "enable_inset",
      "group": "Toggles",
      "type": "boolean",
      "default": true,
      "description": "front inset (added for strength when there is a scoop)",
      "widget": "checkbox"
    },
    {
      "name": "enable_pinch",
      "group": "Toggles",
      "type": "boolean",
      "default": true,
      "description": "\"pinches\" the top lip of the bin, for added strength",
      "widget": "checkbox"
    },
    {
      "name": "gridz_define",
      "group": "Styles",
      "type": "number",
      "default": 0,
      "description": "determine what the variable \"gridz\" applies to based on your use case",
      "widget": "dropdown",
      "options": [
        {
          "value": 0,
          "label": "gridz is the height of bins in units of 7mm increments - Zack's method"
        },
        {
          "value": 1,
          "label": "gridz is the internal height in millimeters"
        },
        {
          "value": 2,
          "label": "gridz is the overall external height of the bin in millimeters"
        }
      ]
    },
    {
      "name": "style_tab",
      "group": "Styles",
      "type": "number",
