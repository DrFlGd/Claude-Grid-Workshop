{
  "source": "vendor/quackworks/openGrid/openGrid-border.scad",
  "groups": [
    "Border Configuration",
    "Advanced Parameters"
  ],
  "parameters": [
    {
      "name": "Full_or_Lite",
      "group": "Border Configuration",
      "type": "string",
      "default": "Lite",
      "description": null,
      "widget": "dropdown",
      "options": [
        {
          "value": "Full",
          "label": "Full"
        },
        {
          "value": "Lite",
          "label": "Lite"
        }
      ]
    },
    {
      "name": "Border_width",
      "group": "Border Configuration",
      "type": "number",
      "default": 2,
      "description": "Length of border in cells",
      "widget": "number"
    },
    {
      "name": "Border_thickness",
      "group": "Border Configuration",
      "type": "number",
      "default": 5.2,
      "description": "Border thickness (min 5.2mm)",
      "widget": "number"
    },
    {
      "name": "Chamfered_at_left_end",
      "group": "Border Configuration",
      "type": "boolean",
      "default": true,
      "description": null,
      "widget": "checkbox"
    },
    {
      "name": "Chamfered_at_right_end",
      "group": "Border Configuration",
      "type": "boolean",
      "default": true,
      "description": null,
      "widget": "checkbox"
    },
    {
      "name": "Left_end_is_corner",
      "group": "Border Configuration",
      "type": "boolean",
      "default": false,
      "description": "Controls how the left end terminates",
      "widget": "checkbox"
    },
    {
      "name": "Right_end_is_corner",
      "group": "Border Configuration",
      "type": "boolean",
      "default": false,
      "description": "Controls how the right end terminates",
      "widget": "checkbox"
    },
    {
      "name": "Connector_Tolerance",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 0.1,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Connector_Protrusion",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 2.0,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Tile_Size",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 28,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Connector_Width",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 3.9,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Connector_Height",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 2.0,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Full_Tile_Thickness",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 6.8,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Lite_Tile_Thickness",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 4,
      "description": null,
      "widget": "number"
    },
    {
      "name": "Chamfer_Triangle_Size",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 4.2,
      "description": null,
      "widget": "number"
    },
    {
      "name": "eps",
      "group": "Advanced Parameters",
      "type": "number",
      "default": 0.005,
      "description": null,
      "widget": "number"
    }
  ],
  "computed_skipped": [
    {
      "name": "Connector_Depth",
      "group": "Advanced Parameters",
      "expression": "Connector_Protrusion"
    },
    {
      "name": "Selected_Tile_Thickness",
      "group": "Advanced Parameters",
      "expression": "Full_or_Lite == \"Full\" ? Full_Tile_Thickness : Lite_Tile_Thickness"
    },
    {
      "name": "Selected_Border_Thickness",
      "group": "Advanced Parameters",
      "expression": "max(5.2, Border_thickness)"
    },
    {
      "name": "Chamfer_Triangle_Depth",
      "group": "Advanced Parameters",
      "expression": "Selected_Border_Thickness"
    },
    {
      "name": "Border_Length_mm",
      "group": "Advanced Parameters",
      "expression": "Border_width * Tile_Size"
    }
  ],
  "model": "opengrid/border"
}
