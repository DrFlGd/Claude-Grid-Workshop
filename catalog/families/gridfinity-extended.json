{
  "$schema": "../../schema/family.schema.json",
  "id": "gridfinity-extended",
  "name": "Gridfinity Extended",
  "category": "gridfinity",
  "tags": [
    "bins",
    "baseplates",
    "dividers",
    "labels"
  ],
  "summary": "Feature-rich Gridfinity bins, baseplates, lids, drawers and holders (silverware, sockets, items) with dividers, labels and patterns.",
  "authors": [
    {
      "name": "ostat",
      "url": "https://github.com/ostat"
    }
  ],
  "source": {
    "repository": "https://github.com/ostat/gridfinity_extended_openscad",
    "commit": "94d5a3e2d39e0b90894c042a255fc487cfcc9197",
    "vendor_path": "vendor/gridfinity-extended"
  },
  "license": {
    "spdx": "GPL-3.0-only",
    "public_use": "ok",
    "notes": "Generated source bundles must keep GPL notices."
  },
  "links": {
    "Documentation": "https://docs.ostat.com/docs/openscad/gridfinity-extended",
    "Donate": "http://paypal.me/ostat1"
  },
  "editor_toml": "vendor/gridfinity-extended/editor.toml",
  "engine": {
    "min_version": "2025.01 (development snapshot)",
    "backend": "manifold",
    "notes": "Uses syntax that OpenSCAD 2021.01 cannot parse.",
    "library_paths": [
      "vendor/libraries"
    ]
  },
  "status": "available",
  "models": [
    {
