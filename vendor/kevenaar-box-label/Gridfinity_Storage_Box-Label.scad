text_size=(text_size_configurable==""?text_size_predefined:text_size_configurable);

$fn=48;

font_recessed=0.75;

//***USE THIS ONLY IF YOU KNOW WHAT YOU ARE DOING***: In case your steps are not in the right heigt, add here some little bit of thickness to your step height. This might help e.g. if you use cura to slice. Its not needed for Simplify3D or Slic3r.
step_thickness_correction=0;

module rounded_square(x,y,z,r)
{
    delta=r;
    
    hull()
    {
        translate([r,r,0]) cylinder(h=z,r=r);
        translate([-r+x,r,0]) cylinder(h=z,r=r);
        translate([r,-r+y,0]) cylinder(h=z,r=r);
        translate([-r+x,-r+y,0])cylinder(h=z,r=r);
    }
}

module textlines(height)
{
    //Size
    spacer=(h-text_size_size)/2;
    translate([ wall,h-spacer-text_size_size,height ])
        linear_extrude(height=th,convexity = 10)
            text(text_size,size=text_size_size,font=fontname,halign="left",valign="baseline");  
    
    //Devider
    substract=(len(text_size)==3?4.4:(len(text_size)==4?11.4:1.4));
    deviderleft=wall+(text_size_size*len(text_size))+linesep-substract;

    echo(deviderleft);
    //h-spacer-text_size_size+wall
    size_devider=19;
    translate([ deviderleft,h-size_devider-wall,height])
        linear_extrude(height=th,convexity = 10)
            text("|",size=size_devider,font=fontname,halign="left",valign="baseline");  

    translate([ (w-deviderleft)/2+deviderleft,h-wall-text_size_text,height ])
        linear_extrude(height=th,convexity = 10)
            text(textstring1,size=text_size_text,font=fontname,halign="center",valign="baseline");
    translate([ (w-deviderleft)/2+deviderleft,h-wall-(text_size_text+text_size_text*linesep),height ])
        linear_extrude(height=th,convexity = 10)
            text(textstring2,size=text_size_text,font=fontname,halign="center",valign="baseline");
    translate([ (w-deviderleft)/2+deviderleft,h-wall-(text_size_text+(text_size_text*(linesep))*2),height ])
        linear_extrude(height=th,convexity = 10)
            text(textstring3,size=text_size_text,font=fontname,halign="center",valign="baseline");
    translate([ (w-deviderleft)/2+deviderleft,h-wall-(text_size_text+(text_size_text*(linesep))*3),height ])
        linear_extrude(height=th,convexity = 10)
            text(textstring4,size=text_size_text,font=fontname,halign="center",valign="baseline");


    // translate([ w-wall,h-wall-text_size_size,height ])
    //     linear_extrude(height=th,convexity = 10)
    //         text(textstring1,size=text_size_size,font=fontname,halign="right",valign="baseline");  
    
    // translate([ wall,h-wall-(text_size_size+textsize_lower*linesep),height ])
    //     linear_extrude(height=th,convexity = 10)
    //             text(textstring2,size=textsize_lower,font=fontname,halign="left",valign="baseline");  
    
    // translate([ w-wall,h-wall-(text_size_size+textsize_lower*linesep),height ])
    //     linear_extrude(height=th,convexity = 10)
    //             text(textstring3,size=textsize_lower,font=fontname,halign="right",valign="baseline");      
}

module swatch(text_type)
{            
    difference()
    {
        rounded_square(w,h,th,round);
        
        if (text_type=="embossed")
        {
            //text
            textlines(th-font_recessed);
        }
    }
    
    if(text_type!="embossed")
    {    
        textlines(th);
    }
}
 

Debug="false";
if (Debug!="true")
{
    swatch(text_type);
}
else
{
    swatch("raised", "disabled");
    translate([w+3,0,0]) swatch("raised", "enabled");
    translate([0,h+3,0]) swatch("embossed", "disabled");
    translate([w+3,h+3,0]) swatch("embossed", "enabled");
}
