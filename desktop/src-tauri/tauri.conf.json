{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCAD Workshop",
  "version": "0.3.0",
  "identifier": "io.github.drflgd.claudegridworkshop",
  "build": {
    "frontendDist": "../../build/desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCAD Workshop",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Generate 3D-printable parts from OpenSCAD models",
    "longDescription": "Generate 3D-printable storage and parts from open-source OpenSCAD models, rendered with native OpenSCAD on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/desktop/site/": "site/",
      "../../build/desktop/starter/": "starter/",
      "../../build/desktop/engine/": "engine/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libopengl0",
          "libegl1",
          "libglx0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
