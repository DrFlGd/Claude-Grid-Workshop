{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "params.schema.json",
  "title": "Extracted parameters",
  "description": "One model's settings in _site/data/models/*.json, built by tools/build_site.py from OpenSCAD's own Customizer export (--export-format=param) plus site and editor.toml metadata.",
  "type": "object",
  "required": [
    "source",
    "groups",
    "parameters"
  ],
  "properties": {
    "model": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "group",
          "type",
          "default",
          "widget"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "type": {
            "enum": [
              "boolean",
              "number",
              "string",
              "number[]",
              "string[]",
              "boolean[]",
              "list"
            ]
          },
          "default": {},
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "widget": {
            "enum": [
              "checkbox",
              "number",
              "slider",
              "dropdown",
              "text",
              "vector"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {},
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "hidden": {
            "type": "boolean"
          },
          "show_if": {
            "type": "string",
            "description": "JS expression over parameter names (editor.toml display-condition)"
          },
          "help_link": {
            "type": "string"
          },
          "description_html": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "presets": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "values": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    "computed_skipped": {
      "type": "array",
      "description": "Top-level assignments that are expressions, not user parameters."
    }
  }
}
