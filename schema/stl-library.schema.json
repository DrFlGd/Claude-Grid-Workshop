{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stl-library.schema.json",
  "title": "STL library",
  "description": "A collection of ready-made model files that can be searched and downloaded. One file per library in catalog/libraries/.",
  "type": "object",
  "required": [
    "id",
    "name",
    "license",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "public_use"
      ],
      "properties": {
        "spdx": {
          "type": "string"
        },
        "public_use": {
          "enum": [
            "ok",
            "review",
            "blocked"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "description": "Where files live: repo path, Git LFS, or object storage base URL.",
      "properties": {
        "kind": {
          "enum": [
            "repo",
            "git-lfs",
            "object-store"
          ]
        },
        "base": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "system": {
            "type": "string",
            "description": "gridfinity, opengrid, multiboard, hsw, ..."
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dimensions": {
            "type": "object",
            "description": "e.g. grid units {x,y,z} or mm {w,d,h}"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "format"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "format": {
                  "enum": [
                    "stl",
                    "3mf",
                    "step",
                    "obj"
                  ]
                },
                "bytes": {
                  "type": "integer"
                },
                "sha256": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "thumbnail": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        }
      }
    }
  }
}
